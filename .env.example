# Copy this file to .env and supply unique values before running Docker Compose.
# These values are intentionally blank so the stack cannot start with public defaults.
MSSQL_SA_PASSWORD=
JWT_SECRET=

# SMTP Configuration (MailHog local defaults)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@propertymanagement.local
SMTP_FROM_NAME=Property Management System

# Payment Providers (supply environment overrides; never commit real secrets)
PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENTS_SIMULATED_WEBHOOK_SECRET=
PAYMENTS_STRIPE_SECRET_KEY=
PAYMENTS_STRIPE_WEBHOOK_SECRET=
PAYMENTS_PAYMOB_API_KEY=
PAYMENTS_PAYMOB_HMAC_SECRET=
PAYMENTS_PAYMOB_INTEGRATION_ID=
PAYMENTS_PAYMOB_IFRAME_ID=
