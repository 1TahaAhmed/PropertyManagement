# Copy this file to .env and supply unique values before running Docker Compose.
# These values are intentionally blank so the stack cannot start with public defaults.
MSSQL_SA_PASSWORD=
JWT_SECRET=

# SMTP Configuration (MailHog local defaults)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@propertymanagement.local
SMTP_FROM_NAME=Property Management System
