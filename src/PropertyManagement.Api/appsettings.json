{
  "Email": {
    "Smtp": {
      "Host": "smtp.example.com",
      "Port": 587,
      "FromEmail": "noreply@propertymanagement.local",
      "FromName": "Property Management",
      "UseSsl": true
    },
    "Confirmation": {
      "BaseUrl": "https://localhost:7261",
      "CodeLifetimeMinutes": 10,
      "Resend": {
        "CooldownSeconds": 60,
        "WindowMinutes": 15,
        "MaxRequestsPerWindow": 5,
        "MaxRequestsPerDay": 20
      }
    }
  },
  "Jwt": {
    "Secret": "CONFIGURE_VIA_USER_SECRETS_OR_ENV_VAR_MIN_32_CHARS",
    "Issuer": "PropertyManagement",
    "Audience": "PropertyManagement",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "ConnectionStrings": {
    "MyConn": "Server=localhost,1433;Database=PropertyManagementDb;User Id=sa;Password=CONFIGURE_VIA_USER_SECRETS_OR_ENV_VAR;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
